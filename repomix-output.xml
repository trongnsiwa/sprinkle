  1: import 'dart:io';
  2: import 'package:flutter/material.dart';
  3: import '../services/image_service.dart';
  4: import '../utils/colors.dart';
  5: class CustomThumbnail extends StatelessWidget {
  6:   final String? imageFileName;
  7:   final File? imageFile;
  8:   final String? imagePath;
  9:   final double size;
 10:   final double borderRadius;
 11:   final bool isCircle;
 12:   final bool hasBorder;
 13:   final Border? customBorder;
 14:   const CustomThumbnail({
 15:     super.key,
 16:     this.imageFileName,
 17:     this.imageFile,
 18:     this.imagePath,
 19:     this.size = 50.0,
 20:     this.borderRadius = 12.0,
 21:     this.isCircle = false,
 22:     this.hasBorder = false,
 23:     this.customBorder,
 24:   });
 25:   @override
 26:   Widget build(BuildContext context) {
 27:     BoxBorder? effectiveBorder;
 28:     if (customBorder != null) {
 29:       effectiveBorder = customBorder;
 30:     } else if (hasBorder) {
 31:       effectiveBorder = Border.all(color: Colors.white, width: 2.0);
 32:     }
 33:     final shape = isCircle ? BoxShape.circle : BoxShape.rectangle;
 34:     final r = isCircle ? BorderRadius.circular(size / 2) : BorderRadius.circular(borderRadius);
 35:     Widget placeholderWidget = Container(
 36:       width: size,
 37:       height: size,
 38:       decoration: BoxDecoration(
 39:         color: AppColors.neutral.withValues(alpha: 0.3),
 40:         shape: shape,
 41:         borderRadius: isCircle ? null : r,
 42:         border: effectiveBorder,
 43:       ),
 44:       child: Center(
 45:         child: Icon(
 46:           Icons.photo_camera_rounded,
 47:           color: Colors.white.withValues(alpha: 0.3),
 48:           size: size * 0.4,
 49:         ),
 50:       ),
 51:     );
 52:     if (imageFile != null) {
 53:       return _buildImageContainer(imageFile!, shape, r, effectiveBorder);
 54:     }
 55:     if (imagePath != null && imagePath!.isNotEmpty) {
 56:       final file = File(imagePath!);
 57:       return _buildImageContainer(file, shape, r, effectiveBorder);
 58:     }
 59:     if (imageFileName != null && imageFileName!.isNotEmpty) {
 60:       return FutureBuilder<File?>(
 61:         future: ImageService.getImageFile(imageFileName!),
 62:         builder: (context, snapshot) {
 63:           if (snapshot.hasData && snapshot.data != null) {
 64:             return _buildImageContainer(snapshot.data!, shape, r, effectiveBorder);
 65:           }
 66:           return placeholderWidget;
 67:         },
 68:       );
 69:     }
 70:     return placeholderWidget;
 71:   }
 72:   Widget _buildImageContainer(
 73:     File file,
 74:     BoxShape shape,
 75:     BorderRadius borderRadius,
 76:     BoxBorder? border,
 77:   ) {
 78:     return Container(
 79:       width: size,
 80:       height: size,
 81:       decoration: BoxDecoration(
 82:         shape: shape,
 83:         borderRadius: isCircle ? null : borderRadius,
 84:         border: border,
 85:       ),
 86:       child: ClipRRect(
 87:         borderRadius: isCircle ? BorderRadius.circular(size / 2) : borderRadius,
 88:         child: Image.file(
 89:           file,
 90:           width: size,
 91:           height: size,
 92:           fit: BoxFit.cover,
 93:           errorBuilder: (context, error, stackTrace) {
 94:             return Container(
 95:               color: AppColors.neutralLight.withValues(alpha: 0.3),
 96:               child: Icon(
 97:                 Icons.broken_image_rounded,
 98:                 color: Colors.white.withValues(alpha: 0.5),
 99:                 size: size * 0.4,
100:               ),
101:             );
102:           },
103:         ),
104:       ),
105:     );
106:   }
107: }
</file>

