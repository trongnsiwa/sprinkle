30:   void dispose() {
31:     _controller.dispose();
32:     super.dispose();
33:   }
34:   void _handleTapDown(TapDownDetails details) {
35:     if (widget.isEnabled) {
36:       _controller.forward();
37:     }
38:   }
39:   void _handleTapUp(TapUpDetails details) {
40:     if (widget.isEnabled) {
41:       _controller.reverse();
42:       widget.onTap();
43:     }
44:   }
45:   void _handleTapCancel() {
46:     if (widget.isEnabled) {
47:       _controller.reverse();
48:     }
49:   }
