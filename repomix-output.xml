 7:   DatabaseService._();
 8:   static DatabaseService get instance {
 9:     _instance ??= DatabaseService._();
10:     return _instance!;
11:   }
12:   Future<Isar> get isar async {
13:     if (_isar != null && _isar!.isOpen) {
14:       return _isar!;
15:     }
16:     _isar = await init();
17:     return _isar!;
18:   }
19:   static Future<Isar> init() async {
20:     if (_isar != null && _isar!.isOpen) {
21:       return _isar!;
22:     }
23:     final dir = await getApplicationDocumentsDirectory();
24:     _isar = await Isar.open(
25:       [VisitRecordSchema],
26:       directory: dir.path,
27:     );
28:     return _isar!;
29:   }
30:   /// Get all visit records sorted by timestamp descending
31:   Future<List<VisitRecord>> getAllVisits() async {
32:     final db = await isar;
33:     return await db.visitRecords.where().sortByTimestampDesc().findAll();
34:   }
35:   /// Watch all visit records as a stream
36:   Stream<List<VisitRecord>> watchVisits() async* {
37:     final db = await isar;
38:     yield* db.visitRecords.where().sortByTimestampDesc().watch(fireImmediately: true);
39:   }
40:   /// Get visit by UUID
41:   Future<VisitRecord?> getVisitByUuid(String uuid) async {
42:     final db = await isar;
43:     return await db.visitRecords.filter().uuidEqualTo(uuid).findFirst();
44:   }
45:   /// Save (insert or update) visit record
46:   Future<void> saveVisit(VisitRecord visit) async {
47:     final db = await isar;
48:     await db.writeTxn(() async {
49:       await db.visitRecords.put(visit);
50:     });
51:   }
52:   /// Delete visit record by UUID
53:   Future<bool> deleteVisit(String uuid) async {
54:     final db = await isar;
55:     return await db.writeTxn(() async {
56:       final record = await db.visitRecords.filter().uuidEqualTo(uuid).findFirst();
57:       if (record != null) {
58:         return await db.visitRecords.delete(record.id);
59:       }
