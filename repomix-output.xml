 2: extension DateTimeFormatter on DateTime {
 3:   /// Returns a friendly formatted date string, e.g., "June 15, 2026 at 2:30 PM"
 4:   String toFriendlyString() {
 5:     final now = DateTime.now();
 6:     final today = DateTime(now.year, now.month, now.day);
 7:     final dateToCheck = DateTime(year, month, day);
 8:     final timeStr = DateFormat('h:mm a').format(this);
 9:     if (dateToCheck == today) {
10:       return 'Today at $timeStr';
11:     } else if (dateToCheck == today.subtract(const Duration(days: 1))) {
12:       return 'Yesterday at $timeStr';
13:     } else if (year == now.year) {
14:       return '${DateFormat('MMMM d').format(this)} at $timeStr';
15:     } else {
16:       return '${DateFormat('MMMM d, yyyy').format(this)} at $timeStr';
17:     }
18:   }
19:   /// Returns short date string, e.g. "MMM d, yyyy"
20:   String toShortDateString() {
21:     return DateFormat('MMM d, yyyy').format(this);
22:   }
23: }
