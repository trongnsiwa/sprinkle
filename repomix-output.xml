  5: class CircularPreview extends StatelessWidget {
  6:   final CameraController? controller;
  7:   final bool isInitialized;
  8:   final bool isMockMode;
  9:   final double diameter;
 10:   const CircularPreview({
 11:     super.key,
 12:     required this.controller,
 13:     required this.isInitialized,
 14:     this.isMockMode = false,
 15:     this.diameter = 300.0,
 16:   });
 17:   @override
 18:   Widget build(BuildContext context) {
 19:     final bool showGlow = isMockMode || (isInitialized && controller != null);
 20:     return Container(
 21:       width: diameter,
 22:       height: diameter,
 23:       decoration: BoxDecoration(
 24:         shape: BoxShape.circle,
 25:         border: Border.all(color: Colors.white, width: 4),
 26:         boxShadow: showGlow
 27:             ? [
 28:                 BoxShadow(
 29:                   color: AppColors.primary.withValues(alpha: 0.25),
 30:                   blurRadius: 20,
 31:                   spreadRadius: 0,
 32:                   offset: Offset.zero,
 33:                 ),
 34:                 BoxShadow(
 35:                   color: Colors.black.withValues(alpha: 0.4),
 36:                   blurRadius: 16,
 37:                   spreadRadius: 0,
 38:                   offset: const Offset(0, 8),
 39:                 ),
 40:               ]
 41:             : null,
 42:       ),
 43:       child: ClipOval(
 44:         child: Stack(
 45:           children: [
 46:             // Sharp Preview content
 47:             if (isMockMode)
 48:               Positioned.fill(
 49:                 child: Container(
 50:                   decoration: const BoxDecoration(
 51:                     gradient: LinearGradient(
 52:                       colors: [Color(0xFF2C3E50), Color(0xFF4CA1AF)],
 53:                       begin: Alignment.topLeft,
 54:                       end: Alignment.bottomRight,
 55:                     ),
