 58:   Future<void> _fetchLocation() async {
 59:     try {
 60:       bool serviceEnabled = await Geolocator.isLocationServiceEnabled();
 61:       if (!serviceEnabled) return;
 62:       LocationPermission permission = await Geolocator.checkPermission();
 63:       if (permission == LocationPermission.denied) {
 64:         permission = await Geolocator.requestPermission();
 65:         if (permission == LocationPermission.denied) return;
 66:       }
 67:       if (permission == LocationPermission.deniedForever) return;
 68:       final position = await Geolocator.getCurrentPosition(
 69:         locationSettings: const LocationSettings(
 70:           accuracy: LocationAccuracy.low,
 71:           timeLimit: Duration(seconds: 3),
 72:         ),
 73:       );
 74:       final placemarks = await placemarkFromCoordinates(
 75:         position.latitude,
 76:         position.longitude,
 77:       );
 78:       if (placemarks.isNotEmpty && mounted) {
 79:         final place = placemarks.first;
 80:         final parts = <String>[];
 81:         if (place.name != null && place.name!.isNotEmpty) parts.add(place.name!);
 82:         if (place.locality != null && place.locality!.isNotEmpty) parts.add(place.locality!);
 83:         final name = parts.join(', ');
 84:         if (_nameController.text.isEmpty && name.isNotEmpty) {
 85:           _nameController.text = name;
 86:           ref.read(addEditViewModelProvider.notifier).setName(name);
 87:         }
 88:       }
 89:     } catch (_) {}
 90:   }
