<file path="lib/services/image_service.dart">
 1: import 'dart:io';
 2: import 'dart:typed_data';
 3: import 'package:image/image.dart' as img;
 4: import 'package:path/path.dart' as path;
 5: import 'package:path_provider/path_provider.dart';
 6: import 'package:uuid/uuid.dart';
 7: class ImageService {
 8:   /// Save and compress image bytes to local storage, returns saved filename
 9:   static Future<String> saveImage(
10:     Uint8List rawBytes, {
11:     int maxWidth = 1200,
12:     int quality = 85,
13:   }) async {
14:     final docsDir = await getApplicationDocumentsDirectory();
15:     final imagesDir = Directory(path.join(docsDir.path, 'images'));
16:     if (!await imagesDir.exists()) {
17:       await imagesDir.create(recursive: true);
18:     }
19:     final decodedImage = img.decodeImage(rawBytes);
20:     Uint8List processedBytes = rawBytes;
21:     if (decodedImage != null) {
22:       img.Image resized = decodedImage;
23:       if (decodedImage.width > maxWidth) {
24:         resized = img.copyResize(decodedImage, width: maxWidth);
25:       }
26:       processedBytes = Uint8List.fromList(img.encodeJpg(resized, quality: quality));
27:     }
28:     final fileName = '${const Uuid().v4()}.jpg';
29:     final filePath = path.join(imagesDir.path, fileName);
30:     final file = File(filePath);
31:     await file.writeAsBytes(processedBytes);
32:     return fileName;
33:   }
34:   /// Get absolute path for an image filename
35:   static Future<String> getImagePath(String fileName) async {
36:     final docsDir = await getApplicationDocumentsDirectory();
37:     return path.join(docsDir.path, 'images', fileName);
38:   }
39:   /// Get File object for an image filename
40:   static Future<File?> getImageFile(String fileName) async {
41:     final fullPath = await getImagePath(fileName);
42:     final file = File(fullPath);
43:     if (await file.exists()) {
44:       return file;
45:     }
46:     return null;
47:   }
48:   /// Delete image file by filename
49:   static Future<bool> deleteImage(String fileName) async {
50:     try {
51:       final fullPath = await getImagePath(fileName);
52:       final file = File(fullPath);
53:       if (await file.exists()) {
54:         await file.delete();
55:         return true;
56:       }
57:     } catch (_) {}
58:     return false;
59:   }
60: }
</file>

