 94:   Future<VisitRecord?> save() async {
 95:     if (!state.isValid || state.isSaving) return null;
 96:     try {
 97:       state = state.copyWith(isSaving: true);
 98:       String? imageFileName = state.existingImageFileName;
 99:       if (state.selectedImagePath != null && state.selectedImagePath!.isNotEmpty) {
100:         final file = File(state.selectedImagePath!);
101:         if (await file.exists()) {
102:           final bytes = await file.readAsBytes();
103:           imageFileName = await ImageService.saveImage(bytes);
104:         }
105:       }
106:       final uuid = state.existingUuid ?? const Uuid().v4();
107:       final record = VisitRecord()
108:         ..uuid = uuid
109:         ..name = state.name.trim()
110:         ..notes = state.notes.trim().isEmpty ? null : state.notes.trim()
111:         ..rating = state.rating
112:         ..timestamp = DateTime.now()
113:         ..imageFileName = imageFileName
114:         ..tags = state.tags;
115:       await DatabaseService.instance.saveVisit(record);
116:       state = state.copyWith(isSaving: false);
117:       return record;
118:     } catch (e) {
