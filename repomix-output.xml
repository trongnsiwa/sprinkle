 1: import 'package:flutter/material.dart';
 2: import '../utils/colors.dart';
 3: class StarRating extends StatelessWidget {
 4:   final double rating;
 5:   final int maxRating;
 6:   final double starSize;
 7:   final ValueChanged<double>? onRatingChanged;
 8:   final bool isInteractive;
 9:   const StarRating({
10:     super.key,
11:     required this.rating,
12:     this.maxRating = 5,
13:     this.starSize = 18.0,
14:     this.onRatingChanged,
15:     this.isInteractive = false,
16:   });
17:   @override
18:   Widget build(BuildContext context) {
19:     return Row(
20:       mainAxisSize: MainAxisSize.min,
21:       children: List.generate(maxRating, (index) {
22:         final starIndex = index + 1;
23:         IconData iconData;
24:         Color color;
25:         if (rating >= starIndex) {
26:           iconData = Icons.star_rounded;
27:           color = AppColors.starGold;
28:         } else if (rating >= starIndex - 0.5) {
29:           iconData = Icons.star_half_rounded;
30:           color = AppColors.starGold;
31:         } else {
32:           iconData = Icons.star_outline_rounded;
33:           color = AppColors.neutralLight.withValues(alpha: 0.4);
34:         }
35:         Widget starWidget = Icon(
36:           iconData,
37:           size: starSize,
38:           color: color,
39:         );
40:         if (isInteractive) {
41:           return GestureDetector(
42:             onTap: () {
43:               onRatingChanged?.call(starIndex.toDouble());
44:             },
45:             child: Padding(
46:               padding: const EdgeInsets.symmetric(horizontal: 2.0),
47:               child: starWidget,
48:             ),
49:           );
50:         }
51:         return Padding(
52:           padding: const EdgeInsets.only(right: 2.0),
53:           child: starWidget,
54:         );
55:       }),
56:     );
57:   }
58: }
</file>

