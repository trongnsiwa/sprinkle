 3: class CustomShutter extends StatefulWidget {
 4:   final VoidCallback onTap;
 5:   final bool isEnabled;
 6:   const CustomShutter({
 7:     super.key,
 8:     required this.onTap,
 9:     this.isEnabled = true,
10:   });
11:   @override
12:   State<CustomShutter> createState() => _CustomShutterState();
13: }
14: class _CustomShutterState extends State<CustomShutter>
15:     with SingleTickerProviderStateMixin {
16:   late AnimationController _controller;
17:   late Animation<double> _scaleAnimation;
18:   @override
19:   void initState() {
20:     super.initState();
21:     _controller = AnimationController(
22:       vsync: this,
23:       duration: const Duration(milliseconds: 100),
24:     );
25:     _scaleAnimation = Tween<double>(begin: 1.0, end: 0.92).animate(
26:       CurvedAnimation(parent: _controller, curve: Curves.easeInOut),
27:     );
28:   }
29:   @override
30:   void dispose() {
31:     _controller.dispose();
32:     super.dispose();
33:   }
34:   void _handleTapDown(TapDownDetails details) {
35:     if (widget.isEnabled) {
36:       _controller.forward();
37:     }
38:   }
39:   void _handleTapUp(TapUpDetails details) {
40:     if (widget.isEnabled) {
41:       _controller.reverse();
42:       widget.onTap();
43:     }
44:   }
45:   void _handleTapCancel() {
46:     if (widget.isEnabled) {
47:       _controller.reverse();
48:     }
49:   }
50:   @override
51:   Widget build(BuildContext context) {
52:     return GestureDetector(
53:       onTapDown: _handleTapDown,
54:       onTapUp: _handleTapUp,
55:       onTapCancel: _handleTapCancel,
56:       child: AnimatedBuilder(
57:         animation: _scaleAnimation,
58:         builder: (context, child) {
