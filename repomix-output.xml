<file path="lib/services/database_service.dart">
 1: import 'package:isar/isar.dart';
 2: import 'package:path_provider/path_provider.dart';
 3: import '../models/visit_record.dart';
 4: class DatabaseService {
 5:   static DatabaseService? _instance;
 6:   static Isar? _isar;
 7:   DatabaseService._();
 8:   static DatabaseService get instance {
 9:     _instance ??= DatabaseService._();
10:     return _instance!;
11:   }
12:   Future<Isar> get isar async {
13:     if (_isar != null && _isar!.isOpen) {
14:       return _isar!;
15:     }
16:     _isar = await init();
17:     return _isar!;
18:   }
19:   static Future<Isar> init() async {
20:     if (_isar != null && _isar!.isOpen) {
21:       return _isar!;
22:     }
23:     final dir = await getApplicationDocumentsDirectory();
24:     _isar = await Isar.open(
25:       [VisitRecordSchema],
26:       directory: dir.path,
27:     );
28:     return _isar!;
29:   }
30:   /// Get all visit records sorted by timestamp descending
31:   Future<List<VisitRecord>> getAllVisits() async {
32:     final db = await isar;
33:     return await db.visitRecords.where().sortByTimestampDesc().findAll();
34:   }
35:   /// Watch all visit records as a stream
36:   Stream<List<VisitRecord>> watchVisits() async* {
37:     final db = await isar;
38:     yield* db.visitRecords.where().sortByTimestampDesc().watch(fireImmediately: true);
39:   }
40:   /// Get visit by UUID
41:   Future<VisitRecord?> getVisitByUuid(String uuid) async {
42:     final db = await isar;
43:     return await db.visitRecords.filter().uuidEqualTo(uuid).findFirst();
44:   }
45:   /// Save (insert or update) visit record
46:   Future<void> saveVisit(VisitRecord visit) async {
47:     final db = await isar;
48:     await db.writeTxn(() async {
49:       await db.visitRecords.put(visit);
50:     });
51:   }
52:   /// Delete visit record by UUID
53:   Future<bool> deleteVisit(String uuid) async {
54:     final db = await isar;
55:     return await db.writeTxn(() async {
56:       final record = await db.visitRecords.filter().uuidEqualTo(uuid).findFirst();
57:       if (record != null) {
58:         return await db.visitRecords.delete(record.id);
59:       }
60:       return false;
61:     });
62:   }
63: }
</file>

<file path="lib/services/image_service.dart">
 1: import 'dart:io';
 2: import 'dart:typed_data';
 3: import 'package:image/image.dart' as img;
 4: import 'package:path/path.dart' as path;
 5: import 'package:path_provider/path_provider.dart';
 6: import 'package:uuid/uuid.dart';
 7: class ImageService {
 8:   /// Save and compress image bytes to local storage, returns saved filename
 9:   static Future<String> saveImage(
10:     Uint8List rawBytes, {
11:     int maxWidth = 1200,
12:     int quality = 85,
13:   }) async {
14:     final docsDir = await getApplicationDocumentsDirectory();
15:     final imagesDir = Directory(path.join(docsDir.path, 'images'));
16:     if (!await imagesDir.exists()) {
17:       await imagesDir.create(recursive: true);
18:     }
19:     final decodedImage = img.decodeImage(rawBytes);
20:     Uint8List processedBytes = rawBytes;
21:     if (decodedImage != null) {
22:       img.Image resized = decodedImage;
23:       if (decodedImage.width > maxWidth) {
24:         resized = img.copyResize(decodedImage, width: maxWidth);
25:       }
26:       processedBytes = Uint8List.fromList(img.encodeJpg(resized, quality: quality));
27:     }
28:     final fileName = '${const Uuid().v4()}.jpg';
29:     final filePath = path.join(imagesDir.path, fileName);
30:     final file = File(filePath);
31:     await file.writeAsBytes(processedBytes);
32:     return fileName;
33:   }
34:   /// Get absolute path for an image filename
35:   static Future<String> getImagePath(String fileName) async {
36:     final docsDir = await getApplicationDocumentsDirectory();
37:     return path.join(docsDir.path, 'images', fileName);
38:   }
39:   /// Get File object for an image filename
40:   static Future<File?> getImageFile(String fileName) async {
41:     final fullPath = await getImagePath(fileName);
42:     final file = File(fullPath);
43:     if (await file.exists()) {
44:       return file;
45:     }
46:     return null;
47:   }
48:   /// Delete image file by filename
49:   static Future<bool> deleteImage(String fileName) async {
50:     try {
51:       final fullPath = await getImagePath(fileName);
52:       final file = File(fullPath);
53:       if (await file.exists()) {
54:         await file.delete();
55:         return true;
56:       }
57:     } catch (_) {}
58:     return false;
59:   }
60: }
</file>

<file path="lib/services/streak_service.dart">
 1: import 'package:shared_preferences/shared_preferences.dart';
 2: class StreakService {
 3:   static const String _lastActiveKey = 'last_active_date';
 4:   static const String _streakKey = 'streak_count';
 5:   /// Get the current streak count
 6:   static Future<int> getStreak() async {
 7:     final prefs = await SharedPreferences.getInstance();
 8:     return prefs.getInt(_streakKey) ?? 0;
 9:   }
10:   /// Update streak based on today's activity
11:   static Future<int> updateStreak() async {
12:     final prefs = await SharedPreferences.getInstance();
13:     final today = DateTime.now();
14:     final todayString = _dateToString(today);
15:     final lastActiveString = prefs.getString(_lastActiveKey);
16:     final currentStreak = prefs.getInt(_streakKey) ?? 0;
17:     // If already active today, return current streak (minimum 1 if zero)
18:     if (lastActiveString == todayString) {
19:       return currentStreak == 0 ? 1 : currentStreak;
20:     }
21:     // If last active was yesterday, increment streak
22:     final yesterday = today.subtract(const Duration(days: 1));
23:     final yesterdayString = _dateToString(yesterday);
24:     int newStreak;
25:     if (lastActiveString == yesterdayString) {
26:       newStreak = currentStreak + 1;
27:     } else {
28:       // Gap detected → reset streak to 1
29:       newStreak = 1;
30:     }
31:     await prefs.setString(_lastActiveKey, todayString);
32:     await prefs.setInt(_streakKey, newStreak);
33:     return newStreak;
34:   }
35:   static String _dateToString(DateTime date) {
36:     return '${date.year}-${date.month}-${date.day}';
37:   }
38: }
</file>

